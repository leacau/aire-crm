{
  "name": "aire-crm-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:apk:local": "node scripts/build-android-local.cjs",
    "build:android:apk:local:reuse": "node scripts/build-android-local.cjs --skip-prebuild",
    "android:sha1:local": "keytool -list -v -keystore android/app/debug.keystore -alias androiddebugkey -storepass android -keypass android",
    "doctor:env": "node scripts/check-env.cjs",
    "eas-build-pre-install": "node scripts/check-env.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@firebase/auth": "^1.13.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "expo": "^57.0.8",
    "expo-device": "~57.0.1",
    "expo-notifications": "~57.0.8",
    "expo-status-bar": "^57.0.1",
    "firebase": "^12.16.0",
    "react": "19.2.3",
    "react-native": "^0.86.0",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-native": "^0.72.8",
    "typescript": "~6.0.3"
  }
}
