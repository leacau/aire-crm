{
  "expo": {
    "name": "Aire CRM",
    "slug": "aire-crm-mobile",
    "scheme": "airecrm",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.airedesantafe.crm",
      "supportsTablet": false
    },
    "android": {
      "package": "com.airedesantafe.crm",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#2563eb"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "${EXPO_PUBLIC_API_BASE_URL}",
      "eas": {
        "projectId": "00f4a315-5804-499a-b017-64038ce65cbe"
      }
    }
  }
}
