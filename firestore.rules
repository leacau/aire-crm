rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'lchena@airedesantafe.com.ar';
    }

    function isManagement() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['Jefe', 'Gerencia', 'Administracion', 'Admin'];
    }

    function isExecutiveManagement() {
      return isSuperAdmin() || (isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['Jefe', 'Gerencia']);
    }

    function isCanjeOperator() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Asesor Canjes';
    }

    function canOperateCanjeClient(clientId) {
      return isSignedIn()
        && (
          isClientOwner(clientId)
          || (
            isCanjeOperator()
            && get(/databases/$(database)/documents/clients/$(clientId)).data.allowCanjes == true
          )
        );
    }

    function createsOwnField(fieldName) {
      return isSignedIn() && request.resource.data[fieldName] == request.auth.uid;
    }

    function isClientOwner(clientId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/clients/$(clientId)).data.ownerId == request.auth.uid;
    }

    function ownsClientOnResource() {
      return isSignedIn()
        && resource.data.clientId is string
        && isClientOwner(resource.data.clientId);
    }

    function ownsClientOnRequest() {
      return isSignedIn()
        && request.resource.data.clientId is string
        && isClientOwner(request.resource.data.clientId);
    }

    function canOperateOrder(orderId) {
      return isSignedIn()
        && (
          get(/databases/$(database)/documents/advertising_orders/$(orderId)).data.createdBy == request.auth.uid
          || (
            get(/databases/$(database)/documents/advertising_orders/$(orderId)).data.clientId is string
            && isClientOwner(get(/databases/$(database)/documents/advertising_orders/$(orderId)).data.clientId)
          )
        );
    }

    function isActorOnResource() {
      return isSignedIn() && (
        resource.data.advisorId == request.auth.uid ||
        resource.data.asesorId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
    }

    function isActorOnRequest() {
      return isSignedIn() && (
        request.resource.data.advisorId == request.auth.uid ||
        request.resource.data.asesorId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
    }

    function advisorUpdatesOwnPaymentEntry() {
      return isSignedIn()
        && resource.data.advisorId == request.auth.uid
        && request.resource.data.advisorId == resource.data.advisorId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['notes', 'nextContactAt', 'status', 'updatedAt'])
        && request.resource.data.status in ['Pendiente', 'Reclamado', 'Pagado', 'Incobrable'];
    }

    function advisorClaimsUnassignedProspect() {
      return isSignedIn()
        && resource.data.get('ownerId', '') in ['', null]
        && resource.data.get('claimStatus', null) == null
        && request.resource.data.claimStatus == 'Pendiente'
        && request.resource.data.claimantId == request.auth.uid
        && request.resource.data.claimantName is string
        && request.resource.data.claimedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['claimStatus', 'claimantId', 'claimantName', 'claimedAt', 'updatedAt']);
    }

    function preservesAdvertisingOrderLink() {
      return !(resource.data.orderId is string)
        || (request.resource.data.orderId is string
          && request.resource.data.orderId == resource.data.orderId);
    }

    function requestedExecutionOrderIsApprovedOrExecutive() {
      return !(request.resource.data.get('orderId', null) is string)
        || isExecutiveManagement()
        || get(/databases/$(database)/documents/advertising_orders/$(request.resource.data.orderId)).data.get('status', null) == 'Aprobado'
        || (get(/databases/$(database)/documents/advertising_orders/$(request.resource.data.orderId)).data.get('status', null) == null
          && get(/databases/$(database)/documents/advertising_orders/$(request.resource.data.orderId)).data.get('approvalHistory', []).size() == 0);
    }

    function executionOrderLinkUpdateAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orderId'])
        || requestedExecutionOrderIsApprovedOrExecutive();
    }

    function hasPersistableOpportunityStage() {
      return request.resource.data.stage != 'Ganado (Recurrente)';
    }

    function linksWonOpportunityForOrder() {
      return request.resource.data.opportunityId is string
        && exists(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId))
        && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.stage == 'Cerrado - Ganado'
        && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.clientId == request.resource.data.clientId;
    }

    function legacyAdvertisingOrderEntersReapproval() {
      return resource.data.get('status', null) != null
        || resource.data.get('approvalHistory', []).size() > 0
        || (request.resource.data.status == 'Pendiente de Modificación'
          && request.resource.data.approvalHistory is list
          && request.resource.data.approvalHistory.size() > 0
          && request.resource.data.revisionHistory is list
          && request.resource.data.revisionHistory.size() > 0);
    }

    function hasValidWonContractPeriod() {
      return request.resource.data.stage != 'Cerrado - Ganado'
        || (request.resource.data.startDate is string
          && request.resource.data.endDate is string
          && request.resource.data.startDate <= request.resource.data.endDate);
    }

    function canUpdateWonContractPeriod() {
      return resource.data.stage != 'Cerrado - Ganado'
        ? hasValidWonContractPeriod()
        : (resource.data.startDate is string && resource.data.endDate is string)
          ? request.resource.data.startDate == resource.data.startDate
            && request.resource.data.endDate == resource.data.endDate
          : ((!(request.resource.data.startDate is string)
              && !(request.resource.data.endDate is string))
            || (request.resource.data.startDate is string
              && request.resource.data.endDate is string
              && request.resource.data.startDate <= request.resource.data.endDate));
    }

    function updatesSelfProfile(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'area', 'managerId', 'permissions', 'sellerConfig', 'deletedAt', 'vacationDays', 'monthlyClosures', 'monthlyObjectives']);
    }

    match /system_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isManagement() || isSuperAdmin();
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if updatesSelfProfile(userId) || isManagement();
      allow delete: if isManagement();
    }

    match /clients/{clientId} {
      allow read, list: if isSignedIn();
      allow create: if createsOwnField('ownerId') || isManagement();
      allow update: if isClientOwner(clientId) || isManagement();
      allow delete: if isManagement();
    }

    match /people/{personId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /opportunities/{oppId} {
      allow read, list: if isSignedIn();
      allow create: if hasPersistableOpportunityStage() && hasValidWonContractPeriod() && (ownsClientOnRequest() || isManagement()
        || (isCanjeOperator() && request.resource.data.isCanje == true && canOperateCanjeClient(request.resource.data.clientId)));
      allow update: if hasPersistableOpportunityStage() && (isManagement() || canUpdateWonContractPeriod()) && (ownsClientOnResource() || isManagement()
        || (isCanjeOperator() && request.resource.data.isCanje == true && canOperateCanjeClient(request.resource.data.clientId)));
      allow delete: if ownsClientOnResource() || isManagement();
    }

    match /commercial_notes/{noteId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if requestedExecutionOrderIsApprovedOrExecutive()
        && (isActorOnRequest() || ownsClientOnRequest() || isManagement());
      allow update: if executionOrderLinkUpdateAllowed()
        && (isExecutiveManagement()
          || (preservesAdvertisingOrderLink()
            && (isManagement() || isActorOnResource() || ownsClientOnResource())));
      allow delete: if isActorOnResource() || ownsClientOnResource() || isManagement();
    }

    match /programs/{programId} {
      allow read: if true;
      allow write, delete: if isManagement();
    }

    match /client-activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isActorOnRequest() || ownsClientOnRequest() || isManagement();
      allow update, delete: if isActorOnResource() || ownsClientOnResource() || isManagement();
    }

    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isManagement();
    }

    match /prospects/{prospectId} {
      allow read: if isSignedIn();
      allow create: if createsOwnField('ownerId') || isManagement();
      allow update: if isActorOnResource() || isManagement() || advisorClaimsUnassignedProspect();
      allow delete: if isActorOnResource() || isManagement();
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isManagement();
    }

    match /payment_entries/{paymentId} {
      allow read: if isSignedIn();
      allow create, delete: if isManagement();
      allow update: if isManagement() || advisorUpdatesOwnPaymentEntry();
    }

    match /billing_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isManagement()
        || (resource.data.orderId is string && canOperateOrder(resource.data.orderId));
    }

    match /advertising_orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if linksWonOpportunityForOrder() && (isActorOnRequest() || ownsClientOnRequest() || isManagement()
        || (isCanjeOperator() && request.resource.data.canjeId is string && canOperateCanjeClient(request.resource.data.clientId)));
      allow update: if linksWonOpportunityForOrder() && legacyAdvertisingOrderEntersReapproval()
        && (isActorOnResource() || ownsClientOnResource() || isManagement()
          || (isCanjeOperator() && resource.data.canjeId is string && canOperateCanjeClient(resource.data.clientId)));
      allow delete: if isActorOnResource() || ownsClientOnResource() || isManagement();
    }

    match /social_media_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if requestedExecutionOrderIsApprovedOrExecutive()
        && (isActorOnRequest() || ownsClientOnRequest() || isManagement());
      allow update: if executionOrderLinkUpdateAllowed()
        && (isExecutiveManagement()
          || (preservesAdvertisingOrderLink()
            && (isManagement() || isActorOnResource() || ownsClientOnResource())));
      allow delete: if isActorOnResource() || ownsClientOnResource() || isManagement();
    }

    match /web_notes/{noteId} {
      allow read: if isSignedIn();
      allow create: if requestedExecutionOrderIsApprovedOrExecutive()
        && (isActorOnRequest() || ownsClientOnRequest() || isManagement());
      allow update: if executionOrderLinkUpdateAllowed()
        && (isExecutiveManagement()
          || (preservesAdvertisingOrderLink()
            && (isManagement() || isActorOnResource() || ownsClientOnResource())));
      allow delete: if isActorOnResource() || ownsClientOnResource() || isManagement();
    }

    match /canjes/{canjeId} {
      allow read: if isSignedIn();
      allow create: if isActorOnRequest() || isManagement()
        || (isCanjeOperator()
          && request.resource.data.clienteId is string
          && canOperateCanjeClient(request.resource.data.clienteId));
      allow update: if isActorOnResource() || isManagement()
        || (isCanjeOperator()
          && resource.data.clienteId is string
          && canOperateCanjeClient(resource.data.clienteId));
      allow delete: if isActorOnResource() || isManagement();
    }

    match /convenios/{convenioId} {
      allow read: if isSignedIn();
      allow create: if isActorOnRequest() || ownsClientOnRequest() || isManagement();
      allow update, delete: if isActorOnResource() || ownsClientOnResource() || isManagement();
    }

    match /licencias/{licenseId} {
      allow read: if isSignedIn();
      allow create: if isActorOnRequest() || isManagement();
      allow update, delete: if isManagement();
    }

    match /agencies/{agencyId} {
      allow read: if isSignedIn();
      allow write, delete: if isManagement();
    }

    match /commercial_items/{itemId} {
      allow read: if isSignedIn();
      allow write, delete: if isManagement();
    }

    match /coaching_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isManagement() || isActorOnRequest();
      allow update, delete: if isManagement() || isActorOnResource();
    }

    match /coaching_active_index/{advisorId} {
      allow read: if isSignedIn() && (request.auth.uid == advisorId || isManagement());
      allow create, update, delete: if isSignedIn() && (request.auth.uid == advisorId || isManagement());
    }

    match /supervisor_comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isManagement();
      allow update, delete: if isManagement() || isActorOnResource();
    }

    match /pipeline_interactions/{interactionId} {
      allow read: if isSignedIn();
      allow create: if isActorOnRequest() || isManagement();
      allow update, delete: if isActorOnResource() || isManagement();
    }

    match /estadisticas_mensuales/{statId} {
      allow read: if isSignedIn();
      allow write: if isManagement();
    }

    match /{collection}/{docId} {
      allow read, write, delete: if false;
    }
  }
}
