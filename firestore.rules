rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'lchena@airedesantafe.com.ar';
    }

    function isManagement() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['Jefe', 'Gerencia', 'Administracion', 'Admin'];
    }

    function createsOwnField(fieldName) {
      return isSignedIn() && request.resource.data[fieldName] == request.auth.uid;
    }

    function isClientOwner(clientId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/clients/$(clientId)).data.ownerId == request.auth.uid;
    }

    function ownsClientOnResource() {
      return isSignedIn()
        && resource.data.clientId is string
        && isClientOwner(resource.data.clientId);
    }

    function ownsClientOnRequest() {
      return isSignedIn()
        && request.resource.data.clientId is string
        && isClientOwner(request.resource.data.clientId);
    }

    function isActorOnResource() {
      return isSignedIn() && (
        resource.data.advisorId == request.auth.uid ||
        resource.data.asesorId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
    }

    function isActorOnRequest() {
      return isSignedIn() && (
        request.resource.data.advisorId == request.auth.uid ||
        request.resource.data.asesorId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
    }

    function updatesSelfProfile(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'area', 'managerId', 'permissions', 'sellerConfig', 'deletedAt', 'vacationDays', 'monthlyClosures', 'monthlyObjectives']);
    }

    match /system_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isManagement() || isSuperAdmin();
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if updatesSelfProfile(userId) || isManagement();
      allow delete: if isManagement();
    }

    match /clients/{clientId} {
      allow read, list: if isSignedIn();
      allow create: if createsOwnField('ownerId') || isManagement();
      allow update: if isClientOwner(clientId) || isManagement();
      allow delete: if isManagement();
    }

    match /people/{personId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /opportunities/{oppId} {
      allow read, list: if isSignedIn();
      allow create: if ownsClientOnRequest() || isManagement();
      allow update, delete: if ownsClientOnResource() || isManagement();
    }

    match /commercial_notes/{noteId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isActorOnRequest() || ownsClientOnRequest() || isManagement();
      allow update, delete: if isActorOnResource() || ownsClientOnResource() || isManagement();
    }

    match /programs/{programId} {
      allow read: if true;
      allow write, delete: if isManagement();
    }

    match /client-activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isActorOnRequest() || ownsClientOnRequest() || isManagement();
      allow update, delete: if isActorOnResource() || ownsClientOnResource() || isManagement();
    }

    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isManagement();
    }

    match /prospects/{prospectId} {
      allow read: if isSignedIn();
      allow create: if createsOwnField('ownerId') || isManagement();
      allow update, delete: if isActorOnResource() || isManagement();
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagement();
    }

    match /payment_entries/{paymentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagement();
    }

    match /billing_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isManagement();
    }

    match /advertising_orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isActorOnRequest() || ownsClientOnRequest() || isManagement();
      allow update, delete: if isActorOnResource() || ownsClientOnResource() || isManagement();
    }

    match /social_media_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isActorOnRequest() || ownsClientOnRequest() || isManagement();
      allow update, delete: if isActorOnResource() || ownsClientOnResource() || isManagement();
    }

    match /web_notes/{noteId} {
      allow read: if isSignedIn();
      allow create: if isActorOnRequest() || ownsClientOnRequest() || isManagement();
      allow update, delete: if isActorOnResource() || ownsClientOnResource() || isManagement();
    }

    match /canjes/{canjeId} {
      allow read: if isSignedIn();
      allow create: if isActorOnRequest() || isManagement();
      allow update, delete: if isActorOnResource() || isManagement();
    }

    match /convenios/{convenioId} {
      allow read: if isSignedIn();
      allow create: if isActorOnRequest() || ownsClientOnRequest() || isManagement();
      allow update, delete: if isActorOnResource() || ownsClientOnResource() || isManagement();
    }

    match /licencias/{licenseId} {
      allow read: if isSignedIn();
      allow create: if isActorOnRequest() || isManagement();
      allow update, delete: if isManagement();
    }

    match /agencies/{agencyId} {
      allow read: if isSignedIn();
      allow write, delete: if isManagement();
    }

    match /commercial_items/{itemId} {
      allow read: if isSignedIn();
      allow write, delete: if isManagement();
    }

    match /coaching_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isManagement();
      allow update, delete: if isManagement() || isActorOnResource();
    }

    match /supervisor_comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isManagement();
      allow update, delete: if isManagement() || isActorOnResource();
    }

    match /pipeline_interactions/{interactionId} {
      allow read: if isSignedIn();
      allow create: if isActorOnRequest() || isManagement();
      allow update, delete: if isActorOnResource() || isManagement();
    }

    match /estadisticas_mensuales/{statId} {
      allow read: if isSignedIn();
      allow write: if isManagement();
    }

    match /{collection}/{docId} {
      allow read, write, delete: if false;
    }
  }
}
